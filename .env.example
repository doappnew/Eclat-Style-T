# --- Serveur ---
PORT=3000
NODE_VERSION=22
# Chaîne aléatoire de 32+ caractères (signe les sessions). Ex: openssl rand -hex 32
SESSION_SECRET=
# --- Supabase (clé service_role: UNIQUEMENT sur le serveur, jamais dans le navigateur) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# --- Pi Network (Developer Portal, même application que l'URL vérifiée) ---
PI_API_KEY=
# Clé de validation du domaine affichée dans le Developer Portal (servie sur /validation-key.txt)
PI_VALIDATION_KEY=
# --- Boutique ---
SHOP_NAME=Éclat & Style
CONTACT_EMAIL=
CONTACT_PHONE=
# --- Service d'éveil (facultatif) ---
# Render fournit RENDER_EXTERNAL_URL automatiquement. Mettre KEEPALIVE=off pour désactiver.
KEEPALIVE=on
KEEPALIVE_URL=
# --- Phase de test Pi ---
# Montant maximal d'une commande, en Pi. Retirer cette ligne (ou mettre 0) avant l'ouverture au public.
PI_MAX_PAYMENT=2
# Envoi de test A2U (Testnet) : fermé par défaut. PI_WALLET_SEED se met uniquement dans Render, jamais ici.
TESTNET_PAYOUT=0
TESTNET_PAYOUT_AMOUNT=0.1
# Plafond fixe : 5 pionniers validés (connexion + paiement de test + envoi reçu)
# PI_WALLET_SEED=

# En-têtes de sécurité : vide = étape A (sans CSP) ; 1 = CSP complète (étape B, à tester) ; 0 = aucun en-tête helmet
STRICT_HEADERS=
