# --- Serveur ---
PORT=3000
NODE_VERSION=22
# Chaîne aléatoire de 32+ caractères (signe les sessions). Ex: openssl rand -hex 32
SESSION_SECRET=
# --- Supabase (clé service_role: UNIQUEMENT sur le serveur, jamais dans le navigateur) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# --- Pi Network (Developer Portal, même application que l'URL vérifiée) ---
PI_API_KEY=
# Clé de validation du domaine affichée dans le Developer Portal (servie sur /validation-key.txt)
PI_VALIDATION_KEY=
# --- Boutique ---
SHOP_NAME=Éclat & Style
CONTACT_EMAIL=
CONTACT_PHONE=
